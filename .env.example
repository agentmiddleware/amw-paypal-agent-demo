# Copy to .env and fill in. Leave a value empty to use the offline stand-in.
# Never commit .env.

# OpenAI. Empty OPENAI_API_KEY means the demo uses a scripted LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PayPal sandbox REST app (developer.paypal.com, Apps and Credentials, Sandbox).
# Empty means the demo uses the offline PayPal fake.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional sandbox test card so orders can be captured with no buyer approval
# step. Use a card from the sandbox card generator, never a real card.
PAYPAL_SANDBOX_CARD_NUMBER=
PAYPAL_SANDBOX_CARD_EXPIRY=

# Merchant price of the checkout tool, in USD.
CHECKOUT_PRICE_USD=25.00
